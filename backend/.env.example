# Sepolia deployment — copy to .env and fill in (never commit .env)

SEPOLIA_RPC_URL=https://ethereum-sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_PRIVATE_KEY

# Optional: defaults to deployer address if unset
VENDOR_ADDRESS=

# Optional: defaults to 0.01 ETH per ticket
TICKET_PRICE_ETH=0.01

# For scripts/verify.js after deployment
ETHERSCAN_API_KEY=
CONTRACT_ADDRESS=

# Sepolia RPC — pick one that works on your network (Windows TLS errors are common with PublicNode).
# Try in order if deploy fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE:
#   https://sepolia.drpc.org
#   https://rpc.sepolia.org
#   https://1rpc.io/sepolia
# Or use Alchemy/Infura: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://sepolia.drpc.org
PRIVATE_KEY=

# Optional: defaults to deployer address if unset
VENDOR_ADDRESS=0x906b4a0773828D6528329ED486ae59F9e08cd5bf

# Optional: defaults to 0.01 ETH per ticket
TICKET_PRICE_ETH=0.01
